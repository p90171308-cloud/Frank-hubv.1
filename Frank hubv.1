-- ฟังก์ชันสร้างช่องใส่ตัวเลข (Number Input Box)
local function createInputControl(parent, labelText, defaultVal, posY, onValueChange)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 20)
    Label.Position = UDim2.new(0, 0, 0, posY)
    Label.BackgroundTransparency = 1
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(200, 200, 200)
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = parent

    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(1, 0, 0, 32)
    Box.Position = UDim2.new(0, 0, 0, posY + 22)
    Box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Box.TextColor3 = Color3.fromRGB(255, 255, 255)
    Box.Text = tostring(defaultVal)
    Box.PlaceholderText = "ใส่ตัวเลขตรงนี้..."
    Box.TextSize = 14
    Box.Font = Enum.Font.GothamBold
    Box.Parent = parent

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 6)
    BoxCorner.Parent = Box

    local BoxStroke = Instance.new("UIStroke")
    BoxStroke.Color = Color3.fromRGB(0, 170, 255)
    BoxStroke.Thickness = 1
    BoxStroke.Parent = Box

    -- ทำงานเมื่อกด Enter หรือกดออกจากช่องพิมพ์
    Box.FocusLost:Connect(function()
        local num = tonumber(Box.Text)
        if num then
            onValueChange(num)
        else
            Box.Text = tostring(defaultVal)
        end
    end)
end

-- 1. ช่องใส่เลขความเร็ว (WalkSpeed)
